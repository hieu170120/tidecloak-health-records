# Copy to .env.docker before starting Docker Compose. Do not commit the copied file.
# Generate unique values before using this outside local development.
POSTGRES_DB=tidecloak_health
POSTGRES_USER=health_owner
POSTGRES_PASSWORD=change-this-postgres-owner-password
APP_DB_PASSWORD=change-this-app-runtime-password
AUDIT_DB_PASSWORD=change-this-audit-writer-password
# For Docker Desktop, host.docker.internal reaches TideCloak running on the host.
# Make these match the active adapter configuration, not the placeholder config.
TIDECLOAK_ISSUER_URL=http://host.docker.internal:8080/realms/myrealm
TIDECLOAK_AUDIENCE=hackathon-rmit
TIDECLOAK_CLIENT_ID=hackathon-rmit
